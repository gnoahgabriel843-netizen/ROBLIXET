<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blox Burt</title>

<style>
* {
  box-sizing: border-box;
  user-select: none;
}

body {
  margin: 0;
  overflow: hidden;
  background: #87ceeb;
  font-family: Arial, sans-serif;
}

#game {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(#6ec6ff 0%, #b9ecff 55%, #4aa3df 55%);
}

#island {
  position: absolute;
  width: 900px;
  height: 550px;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #5fcf5f;
  border: 25px solid #d8b06a;
  border-radius: 45%;
  box-shadow: 0 15px 0 rgba(0,0,0,.15);
}

#player {
  position: absolute;
  width: 45px;
  height: 55px;
  background: #3498db;
  border: 4px solid #222;
  border-radius: 10px;
  left: 430px;
  top: 250px;
  z-index: 5;
}

#player:before {
  content: "";
  position: absolute;
  width: 35px;
  height: 20px;
  background: #f5cfa0;
  top: -22px;
  left: 1px;
  border: 4px solid #222;
  border-radius: 50% 50% 10px 10px;
}

.enemy {
  position: absolute;
  width: 45px;
  height: 45px;
  background: #e74c3c;
  border: 4px solid #222;
  border-radius: 10px;
  z-index: 4;
}

#hud {
  position: fixed;
  top: 15px;
  left: 15px;
  z-index: 20;
  color: white;
  text-shadow: 2px 2px #222;
  font-weight: bold;
}

#healthBox {
  width: 180px;
  height: 22px;
  background: #333;
  border: 3px solid white;
  border-radius: 10px;
  overflow: hidden;
}

#health {
  width: 100%;
  height: 100%;
  background: #2ecc71;
  transition: width 0.2s ease;
}

#money {
  margin-top: 8px;
  font-size: 18px;
}

#quest {
  margin-top: 8px;
  font-size: 15px;
}

#controls {
  position: fixed;
  bottom: 25px;
  left: 25px;
  z-index: 30;
  display: grid;
  grid-template-columns: 55px 55px 55px;
  gap: 5px;
}

.btn {
  width: 55px;
  height: 55px;
  border: 3px solid white;
  border-radius: 15px;
  background: rgba(0,0,0,.45);
  color: white;
  font-size: 25px;
}

#up { grid-column: 2; }
#left { grid-column: 1; }
#down { grid-column: 2; }
#right { grid-column: 3; }

#attack {
  position: fixed;
  right: 25px;
  bottom: 40px;
  width: 85px;
  height: 85px;
  border-radius: 50%;
  background: #e74c3c;
  border: 5px solid white;
  color: white;
  font-weight: bold;
  z-index: 30;
}

#message {
  position: fixed;
  top: 15px;
  right: 15px;
  background: rgba(0,0,0,.6);
  color: white;
  padding: 10px;
  border-radius: 10px;
  z-index: 30;
}
</style>
</head>

<body>

<div id="game">
  <div id="island">
    <div id="player"></div>
    <div class="enemy" id="enemy1"></div>
    <div class="enemy" id="enemy2"></div>
    <div class="enemy" id="enemy3"></div>
  </div>
</div>

<div id="hud">
  <div>❤️ Vie</div>
  <div id="healthBox">
    <div id="health"></div>
  </div>

  <div id="money">💰 Argent : 0</div>
  <div id="quest">🎯 Quête : bats 3 ennemis</div>
</div>

<div id="message">Blox Burt</div>

<div id="controls">
  <button class="btn" id="up">▲</button>
  <button class="btn" id="left">◀</button>
  <button class="btn" id="down">▼</button>
  <button class="btn" id="right">▶</button>
</div>

<button id="attack">ATTAQUE</button>

<script>
const player = document.getElementById("player");
const healthBar = document.getElementById("health");
const moneyText = document.getElementById("money");
const questText = document.getElementById("quest");
const message = document.getElementById("message");

let x = 430;
let y = 250;
let health = 100;
let money = 0;
let defeated = 0;
let gameOver = false;
let lastAttackTime = 0;

const speed = 8;
const attackRange = 90;
const attackCooldown = 300;

const enemies = [
  { id: "enemy1", x: 180, y: 150, alive: true, vx: 1, vy: 1, speed: 1.1 },
  { id: "enemy2", x: 650, y: 180, alive: true, vx: -1, vy: 1, speed: 1.4 },
  { id: "enemy3", x: 300, y: 390, alive: true, vx: 1, vy: -1, speed: 1.2 }
];

function updateHealthBar() {
  healthBar.style.width = health + "%";
  if (health > 60) {
    healthBar.style.background = "#2ecc71";
  } else if (health > 25) {
    healthBar.style.background = "#f1c40f";
  } else {
    healthBar.style.background = "#e74c3c";
  }
}

function updatePlayer() {
  player.style.left = x + "px";
  player.style.top = y + "px";
}

function renderEnemies() {
  enemies.forEach(enemy => {
    const el = document.getElementById(enemy.id);
    if (!el) return;

    if (!enemy.alive) {
      el.style.display = "none";
      return;
    }

    el.style.left = enemy.x + "px";
    el.style.top = enemy.y + "px";
    el.style.display = "block";
  });
}

function move(direction) {
  if (gameOver) return;

  if (direction === "up") y -= speed;
  if (direction === "down") y += speed;
  if (direction === "left") x -= speed;
  if (direction === "right") x += speed;

  x = Math.max(20, Math.min(835, x));
  y = Math.max(20, Math.min(475, y));

  updatePlayer();
}

function updateQuestText() {
  if (defeated >= 3) {
    questText.textContent = "✅ Quête terminée !";
  } else {
    questText.textContent = "🎯 Quête : bats 3 ennemis (" + defeated + "/3)";
  }
}

function attack() {
  if (gameOver) return;

  const now = Date.now();
  if (now - lastAttackTime < attackCooldown) return;
  lastAttackTime = now;

  let hit = false;

  enemies.forEach(enemy => {
    if (!enemy.alive) return;

    const distance = Math.hypot(x - enemy.x, y - enemy.y);

    if (distance < attackRange) {
      enemy.alive = false;
      defeated++;
      money += 100;
      hit = true;
      message.textContent = "⚔️ Ennemi vaincu !";

      updateQuestText();

      if (defeated >= 3) {
        money += 300;
        message.textContent = "🎉 Quête terminée ! +300";
      }

      moneyText.textContent = "💰 Argent : " + money;
    }
  });

  if (!hit) {
    message.textContent = "🥊 Attaque ratée !";
  }

  renderEnemies();
}

function handleEnemyCollision() {
  enemies.forEach(enemy => {
    if (!enemy.alive) return;

    const enemyCenterX = enemy.x + 22;
    const enemyCenterY = enemy.y + 22;
    const playerCenterX = x + 22;
    const playerCenterY = y + 22;

    const distance = Math.hypot(playerCenterX - enemyCenterX, playerCenterY - enemyCenterY);

    if (distance < 35) {
      health = Math.max(0, health - 12);
      updateHealthBar();
      message.textContent = "💥 Tu as pris un coup !";

      if (health <= 0) {
        gameOver = true;
        message.textContent = "💀 Tu es mort ! Appuie sur R pour rejouer";
      }
    }
  });
}

function updateEnemies() {
  if (gameOver) return;

  enemies.forEach(enemy => {
    if (!enemy.alive) return;

    enemy.x += enemy.vx * enemy.speed;
    enemy.y += enemy.vy * enemy.speed;

    if (enemy.x < 30 || enemy.x > 820) enemy.vx *= -1;
    if (enemy.y < 30 || enemy.y > 490) enemy.vy *= -1;

    enemy.x = Math.max(20, Math.min(830, enemy.x));
    enemy.y = Math.max(20, Math.min(475, enemy.y));
  });

  renderEnemies();
  handleEnemyCollision();
}

function resetGame() {
  x = 430;
  y = 250;
  health = 100;
  money = 0;
  defeated = 0;
  gameOver = false;
  lastAttackTime = 0;

  enemies.forEach((enemy, index) => {
    enemy.alive = true;
    if (index === 0) { enemy.x = 180; enemy.y = 150; enemy.vx = 1; enemy.vy = 1; }
    if (index === 1) { enemy.x = 650; enemy.y = 180; enemy.vx = -1; enemy.vy = 1; }
    if (index === 2) { enemy.x = 300; enemy.y = 390; enemy.vx = 1; enemy.vy = -1; }
  });

  updatePlayer();
  renderEnemies();
  updateHealthBar();
  moneyText.textContent = "💰 Argent : 0";
  updateQuestText();
  message.textContent = "Blox Burt";
}

document.getElementById("up").ontouchstart = () => move("up");
document.getElementById("down").ontouchstart = () => move("down");
document.getElementById("left").ontouchstart = () => move("left");
document.getElementById("right").ontouchstart = () => move("right");

document.getElementById("up").onclick = () => move("up");
document.getElementById("down").onclick = () => move("down");
document.getElementById("left").onclick = () => move("left");
document.getElementById("right").onclick = () => move("right");

document.getElementById("attack").onclick = () => {
  if (gameOver) {
    resetGame();
    return;
  }
  attack();
};

document.addEventListener("keydown", e => {
  if (e.key === "ArrowUp" || e.key === "w") move("up");
  if (e.key === "ArrowDown" || e.key === "s") move("down");
  if (e.key === "ArrowLeft" || e.key === "a") move("left");
  if (e.key === "ArrowRight" || e.key === "d") move("right");
  if (e.key === " ") attack();
  if (e.key === "r" || e.key === "R") resetGame();
});

setInterval(updateEnemies, 30);
updateHealthBar();
updatePlayer();
renderEnemies();
updateQuestText();
</script>

</body>
</html>
