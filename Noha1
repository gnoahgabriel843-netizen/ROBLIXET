<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blox Burt</title>

<style>
* {
  box-sizing: border-box;
  user-select: none;
}

body {
  margin: 0;
  overflow: hidden;
  background: #87ceeb;
  font-family: Arial, sans-serif;
}

#game {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(#6ec6ff 0%, #b9ecff 55%, #4aa3df 55%);
}

#island {
  position: absolute;
  width: 900px;
  height: 550px;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #5fcf5f;
  border: 25px solid #d8b06a;
  border-radius: 45%;
  box-shadow: 0 15px 0 rgba(0,0,0,.15);
}

#player {
  position: absolute;
  width: 45px;
  height: 55px;
  background: #3498db;
  border: 4px solid #222;
  border-radius: 10px;
  left: 430px;
  top: 250px;
  z-index: 5;
}

#player:before {
  content: "";
  position: absolute;
  width: 35px;
  height: 20px;
  background: #f5cfa0;
  top: -22px;
  left: 1px;
  border: 4px solid #222;
  border-radius: 50% 50% 10px 10px;
}

.enemy {
  position: absolute;
  width: 45px;
  height: 45px;
  background: #e74c3c;
  border: 4px solid #222;
  border-radius: 10px;
  z-index: 4;
}

#enemy1 { left: 180px; top: 150px; }
#enemy2 { left: 650px; top: 180px; }
#enemy3 { left: 300px; top: 390px; }

#hud {
  position: fixed;
  top: 15px;
  left: 15px;
  z-index: 20;
  color: white;
  text-shadow: 2px 2px #222;
  font-weight: bold;
}

#healthBox {
  width: 180px;
  height: 22px;
  background: #333;
  border: 3px solid white;
  border-radius: 10px;
  overflow: hidden;
}

#health {
  width: 100%;
  height: 100%;
  background: #2ecc71;
}

#money {
  margin-top: 8px;
  font-size: 18px;
}

#quest {
  margin-top: 8px;
  font-size: 15px;
}

#controls {
  position: fixed;
  bottom: 25px;
  left: 25px;
  z-index: 30;
  display: grid;
  grid-template-columns: 55px 55px 55px;
  gap: 5px;
}

.btn {
  width: 55px;
  height: 55px;
  border: 3px solid white;
  border-radius: 15px;
  background: rgba(0,0,0,.45);
  color: white;
  font-size: 25px;
}

#up { grid-column: 2; }
#left { grid-column: 1; }
#down { grid-column: 2; }
#right { grid-column: 3; }

#attack {
  position: fixed;
  right: 25px;
  bottom: 40px;
  width: 85px;
  height: 85px;
  border-radius: 50%;
  background: #e74c3c;
  border: 5px solid white;
  color: white;
  font-weight: bold;
  z-index: 30;
}

#message {
  position: fixed;
  top: 15px;
  right: 15px;
  background: rgba(0,0,0,.6);
  color: white;
  padding: 10px;
  border-radius: 10px;
  z-index: 30;
}
</style>
</head>

<body>

<div id="game">

  <div id="island">

    <div id="player"></div>

    <div class="enemy" id="enemy1"></div>
    <div class="enemy" id="enemy2"></div>
    <div class="enemy" id="enemy3"></div>

  </div>

</div>

<div id="hud">
  <div>❤️ Vie</div>
  <div id="healthBox">
    <div id="health"></div>
  </div>

  <div id="money">💰 Argent : 0</div>
  <div id="quest">🎯 Quête : bats 3 ennemis</div>
</div>

<div id="message">Blox Burt</div>

<div id="controls">
  <button class="btn" id="up">▲</button>
  <button class="btn" id="left">◀</button>
  <button class="btn" id="down">▼</button>
  <button class="btn" id="right">▶</button>
</div>

<button id="attack">ATTAQUE</button>

<script>

const player = document.getElementById("player");
const healthBar = document.getElementById("health");
const moneyText = document.getElementById("money");
const questText = document.getElementById("quest");
const message = document.getElementById("message");

let x = 430;
let y = 250;

let health = 100;
let money = 0;
let defeated = 0;

const speed = 8;

function updatePlayer() {
  player.style.left = x + "px";
  player.style.top = y + "px";
}

function move(direction) {

  if (direction === "up") y -= speed;
  if (direction === "down") y += speed;
  if (direction === "left") x -= speed;
  if (direction === "right") x += speed;

  x = Math.max(20, Math.min(835, x));
  y = Math.max(20, Math.min(475, y));

  updatePlayer();
}

function attack() {

  const enemies = document.querySelectorAll(".enemy");

  enemies.forEach(enemy => {

    if (enemy.style.display === "none") return;

    const ex = parseInt(enemy.style.left);
    const ey = parseInt(enemy.style.top);

    const distance = Math.sqrt(
      Math.pow(x - ex, 2) +
      Math.pow(y - ey, 2)
    );

    if (distance < 90) {

      enemy.style.display = "none";

      defeated++;
      money += 100;

      moneyText.textContent = "💰 Argent : " + money;

      questText.textContent =
        "🎯 Quête : bats 3 ennemis (" +
        defeated +
        "/3)";

      if (defeated >= 3) {
        questText.textContent = "✅ Quête terminée !";
        message.textContent = "🎉 Quête terminée ! +300";
        money += 300;
        moneyText.textContent = "💰 Argent : " + money;
      }
    }
  });
}

document.getElementById("up").ontouchstart =
() => move("up");

document.getElementById("down").ontouchstart =
() => move("down");

document.getElementById("left").ontouchstart =
() => move("left");

document.getElementById("right").ontouchstart =
() => move("right");

document.getElementById("up").onclick =
() => move("up");

document.getElementById("down").onclick =
() => move("down");

document.getElementById("left").onclick =
() => move("left");

document.getElementById("right").onclick =
() => move("right");

document.getElementById("attack").onclick = attack;

document.addEventListener("keydown", e => {

  if (e.key === "ArrowUp" || e.key === "w")
    move("up");

  if (e.key === "ArrowDown" || e.key === "s")
    move("down");

  if (e.key === "ArrowLeft" || e.key === "a")
    move("left");

  if (e.key === "ArrowRight" || e.key === "d")
    move("right");

  if (e.key === " ")
    attack();

});

updatePlayer();

</script>

</body>
</html>
